# ============ 数据库 ============
# postgresql 生产 / sqlite 本地开发演示（无 Docker 时）
DB_BACKEND=postgresql
POSTGRES_USER=webagent
POSTGRES_PASSWORD=webagent_secret
POSTGRES_DB=webagent
# postgresql：postgresql+asyncpg://...  sqlite：sqlite:///./webagent.db
DATABASE_URL=postgresql+asyncpg://webagent:webagent_secret@localhost:5432/webagent

# ============ 对象存储 ============
# minio 生产 / local 本地文件夹（sqlite 本地演示配套）
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./.local_storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=web-agent-docs
MINIO_SECURE=false

# ============ 鉴权 ============
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ============ CORS ============
# 虚机部署改为实际前端域名，逗号分隔多个
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ DeepSeek（密钥只放服务端，前端仓库零密钥） ============
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
# 价格（元 / 百万 tokens，按官方价目表调整）
DEEPSEEK_PRICE_INPUT_PER_MILLION=2.0
DEEPSEEK_PRICE_OUTPUT_PER_MILLION=8.0

# 用户模型配置的 API Key 加密主密钥。使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
# 生产与 Jenkins 环境请由 Credentials 注入，绝不可提交真实值。
MODEL_CONFIG_ENCRYPTION_KEY=jFmL8108VYDECAhGp4fEs4q2b4boQ7f32pzKQCxlqt0=

# ============ 运行环境 ============
# production 时 embedding 必须真实可用（hash 降级会被启动校验拒绝）；development 允许降级演示
ENVIRONMENT=development

# ============ Embedding（后端可切换） ============
# fastembed：本地 BGE（生产 Docker 默认，需 onnxruntime，Python 3.12）
# openai：OpenAI 兼容 embedding API（DeepSeek 无 embedding，可用 OpenAI/通义等）
# sentence_transformers：本地 torch（备选）
# hash：无语义降级，仅 development 演示跑通链路（生产禁止）
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
FASTEMBED_CACHE_PATH=./.models
# openai 后端配置（EMBEDDING_BACKEND=openai 时必填）
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 是否允许 hash 降级（生产必须 false）
ALLOW_HASH_EMBEDDING=true

# ============ 重排序（cross-encoder rerank，依赖 fastembed，生产 Docker 可开） ============
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_MULTIPLIER=4

# ============ 切分与召回 ============
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=5
# 切分策略：window 滑动窗口 / semantic 语义分块（按 Markdown 标题，父子块）
CHUNK_STRATEGY=window
# 混合检索：向量 + 关键词（Postgres tsvector / SQLite LIKE）RRF 融合
HYBRID_SEARCH_ENABLED=true

# ============ Langfuse 追踪（可观测性，无 key 自动禁用） ============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============ 任务与配额 ============
TASK_TIMEOUT_SECONDS=300
TASK_MAX_RETRIES=3
TASK_RETRY_BASE_SECONDS=5
QUOTA_MONTHLY_TOKENS=1000000

# ============ 演示账号（seed 脚本创建） ============
SEED_ADMIN_USERNAME=demo
SEED_ADMIN_PASSWORD=demo1234
