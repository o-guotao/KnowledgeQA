# ============ 部署 Profile（一个开关切换整套后端，见 backend/app/profiles.py） ============
# local      = 本地无 Docker 演示（sqlite 文件库 + 本地文件夹存储 + fastembed 本地向量）
# production = Docker 生产（postgres + minio + fastembed + 重排，禁止 hash 降级）
# 本地直跑改这一个值即可切换；docker compose 内由 docker-compose.yml 强制覆盖为 production。
DEPLOY_PROFILE=local

# ============ 数据库 ============
POSTGRES_USER=webagent
POSTGRES_PASSWORD=webagent_secret
POSTGRES_DB=webagent
# 本地开发（非 docker）时使用 localhost；compose 内由 docker-compose.yml 覆盖为 db 主机名
DATABASE_URL=postgresql+asyncpg://webagent:webagent_secret@localhost:5432/webagent

# ============ 对象存储 ============
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=web-agent-docs
MINIO_SECURE=false

# ============ 鉴权 ============
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ============ CORS ============
# 虚机部署改为实际前端域名，逗号分隔多个
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 用户模型配置的 API Key 加密主密钥。使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
# 生产与 Jenkins 环境请由 Credentials 注入，绝不可提交真实值。
MODEL_CONFIG_ENCRYPTION_KEY=jFmL8108VYDECAhGp4fEs4q2b4boQ7f32pzKQCxlqt0=

# ============ DeepSeek（密钥只放服务端，前端仓库零密钥） ============
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
# 价格（元 / 百万 tokens，按官方价目表调整）
DEEPSEEK_PRICE_INPUT_PER_MILLION=2.0
DEEPSEEK_PRICE_OUTPUT_PER_MILLION=8.0

# ============ Embedding（本地 BGE，无需额外密钥） ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
FASTEMBED_CACHE_PATH=./.models

# ============ 切分默认值（评测时通过环境变量调整后重启 worker 生效） ============
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=5

# ============ 任务与配额 ============
TASK_TIMEOUT_SECONDS=300
TASK_MAX_RETRIES=3
TASK_RETRY_BASE_SECONDS=5
QUOTA_MONTHLY_TOKENS=1000000

# ============ 演示账号（seed 脚本创建） ============
SEED_ADMIN_USERNAME=demo
SEED_ADMIN_PASSWORD=demo1234
